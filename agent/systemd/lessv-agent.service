[Unit]
Description=LessV node agent (Xray config reconciler)
Documentation=https://gitee.com/realumino/lessv
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The release tarball unpacks to /usr/local/lib/lessv-agent (install.sh),
# not the interpreter's site-packages; without PYTHONPATH the -m import
# cannot see the package and the unit dies instantly.
Environment=PYTHONPATH=/usr/local/lib/lessv-agent
ExecStart=/usr/bin/env python3 -m lessv_agent run
Restart=on-failure
RestartSec=5
User=root
Group=root
# Config holds the node token (mode 0600); state holds applied hash.
ReadWritePaths=/etc/lessv /var/lib/lessv
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
