{
  // WHAT: the committed template for the local wrangler.jsonc.
  //
  // WHY this file exists: wrangler.jsonc is the single source of truth for
  // every wrangler command (dev, deploy, migrations, types) and it carries
  // operator-specific values that must never be committed — the deploy
  // hostname, and after the first deploy the D1 database_id that wrangler
  // writes back. Both live in the gitignored wrangler.jsonc; this template
  // holds only a placeholder hostname. Copy it to wrangler.jsonc (the npm
  // pre-hooks do that automatically when the file is missing) and edit the
  // field marked EDIT below before deploying.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lessv",
  "main": "src/worker.ts",
  // The runtime feature set pinned by this date. workerd executes the TS
  // plane natively. Bump deliberately, in a commit, never casually — the
  // test suite and the deploy both run on this date's runtime.
  "compatibility_date": "2026-09-17",

  // The panel takes a custom domain on a zone of this account, so
  // workers.dev and preview URLs are both off: exactly one address
  // exists, and it is the one DNS points at.
  "workers_dev": false,
  "preview_urls": false,
  // EDIT before deploying: hostname on a proxied zone of your account.
  // `wrangler deploy` creates the DNS record and attaches the domain.
  "routes": [{ "pattern": "cp.example.com", "custom_domain": true }],

  // No database_id in the template on purpose: `wrangler deploy`
  // auto-provisions a D1 named `database_name` (or `<worker>-db` when
  // this field is absent) and writes the real id back into
  // wrangler.jsonc; `wrangler dev` creates the local database with the
  // same binding. Migrations are NOT run by deploy — apply them
  // explicitly (npm run deploy does, after wrangler deploy); this is the
  // directory that command reads.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lessv",
      "migrations_dir": "migrations"
    }
  ],

  // Certificate artifacts (the leaf PEMs and the sealed leaf key) live in
  // D1, in `certificate_artifacts`; there is no object store to declare.
  // The workflow runs the issuance steps on a schedule. The cron is UTC
  // 03:17 daily and only touches production certificates.
  "workflows": [
    {
      "name": "lessv-cert-issuance",
      "binding": "ISSUANCE",
      "class_name": "CertificateWorkflow"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },

  // Names only, never values. `wrangler types` generates Env from this
  // list (CI-safe), `wrangler dev` warns when one is missing, and
  // `wrangler deploy` fails closed until every name has a value — which,
  // on the FIRST deploy, can only be supplied via
  // `wrangler deploy --secrets-file <file>` because `wrangler secret
  // put` cannot address a Worker that does not exist yet.
  //
  // WHY both names matter locally too: `wrangler dev` binds a .dev.vars
  // key only when the config declares it, so an undeclared key silently
  // stays missing at runtime (401s that look like a wrong value).
  "secrets": {
    "required": ["ADMIN_KEY", "KEY_SECRET", "CF_DNS_API_TOKEN"]
  },

  // Static assets own /admin (built by frontend/, nested to mirror the
  // path). Assets are matched before the Worker, so /admin/* never
  // invokes the Worker and the route-group guard keeps its four prefixes.
  // Keep in step with frontend/vite.config.ts (base /admin/, outDir
  // dist/admin).
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
