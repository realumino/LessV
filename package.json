{
  "name": "lessv",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "types": "wrangler types",
    "predev": "node scripts/stub_frontend_dist.mjs && node scripts/ensure_wrangler_config.mjs",
    "prebuild": "node scripts/stub_frontend_dist.mjs && node scripts/ensure_wrangler_config.mjs",
    "pretest": "node scripts/ensure_wrangler_config.mjs",
    "pretest:watch": "node scripts/ensure_wrangler_config.mjs",
    "pretypes": "node scripts/ensure_wrangler_config.mjs",
    "build": "wrangler deploy --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "release:node": "node scripts/release_node.mjs"
  },
  "dependencies": {
    "@abraham/reflection": "^0.13.0",
    "@noble/curves": "^2.4.0",
    "@peculiar/x509": "^2.2.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
