#!/sbin/openrc-run
# Xray under OpenRC (Alpine), managed by lessv-node.
#
# WHY supervise-daemon: the reconciler restarts Xray through
# `rc-service xray restart`, and supervise-daemon both reparents the process
# and writes /run/xray.pid, which the node reports in its heartbeat.
description="Xray Service (managed by lessv-node)"
supervisor="supervise-daemon"
command="/usr/local/bin/xray"
command_args="run -config /var/lib/lessv/config.json"
command_user="root:root"
pidfile="/run/xray.pid"
output_log="/var/log/xray.log"
error_log="/var/log/xray.log"
respawn_delay=5
respawn_max=0

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log
}
