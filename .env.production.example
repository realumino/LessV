# WHAT: template for the gitignored .env.production — the secret file
# passed to deploys:
#
#   npm run deploy -- --secrets-file .env.production
#
# Never commit it, never print it. Generate values:
#   node -e "console.log('ADMIN_KEY=' + require('node:crypto').randomBytes(32).toString('base64url'))"
#   node -e "console.log('KEY_SECRET=' + require('node:crypto').randomBytes(32).toString('base64'))"
#
# Use different values from .dev.vars. Rotating KEY_SECRET strands every
# sealed REALITY key already stored (see .dev.vars.example).

ADMIN_KEY=base64url-of-32-random-bytes
KEY_SECRET=base64-of-32-random-bytes

# Enabled in P1b (DNS-01 certificate automation): a Cloudflare token with
# Zone.DNS Edit + Zone.Zone Read scoped to the certificate zone(s). The
# Worker uses it to create/clean `_acme-challenge` TXT records and to list
# zones in the certificate UI. Never put it in wrangler.jsonc.
CF_DNS_API_TOKEN=
