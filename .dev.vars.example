# WHAT: template for the gitignored .dev.vars — the LOCAL-DEVELOPMENT
# secret file. `.dev.vars` is a wrangler dev feature: wrangler loads it
# when `npm run dev` starts and never when deploying, so this file has no
# effect on production. Copy it to `.dev.vars` and paste real values.
#
# Every key here MUST also be declared in wrangler.jsonc's
# `secrets.required` (see wrangler.example.jsonc): wrangler only binds
# names the config declares, so an undeclared key silently stays missing
# at runtime (401s that look like a wrong value).
#
# Generate a value:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Production is a separate file with separate values: .env.production,
# passed to deploys via
#   npm run deploy -- --secrets-file .env.production
# and rotated afterwards with `npx wrangler secret put <NAME>`.
# .env.production is read only when you pass it explicitly — it is not
# loaded by dev, tests, or typecheck. Both files are gitignored.
#
# Warnings:
#  - There is no admin key here. Panel identities are rows: mint the first
#    one with `node scripts/admin_key.mjs create --label dev --local`
#    after the local database exists — a fresh local D1 has no row, and a
#    plane with no row accepts nothing.
#  - Use DIFFERENT values locally and in production.
#  - Rotating a KEY_SECRET in production strands every sealed REALITY key
#    ever stored (they are unreadable without it). Generate once per
#    deployment, keep it backed up, rotate only with a plan.
#  - Never pipe these values into wrangler from PowerShell 5.1: the pipe
#   prepends a UTF-8 BOM and the decoder rejects it. Use the interactive
#   prompt (`npx wrangler secret put`) or a dotenv file.

# AES-256-GCM key that seals REALITY private keys at rest. base64 of 32
# random bytes. NOT rotatable without a migration plan; see warning above.
KEY_SECRET=base64-of-32-random-bytes

# Enabled in P1b (DNS-01 certificate automation): a Cloudflare token with
# Zone.DNS Edit + Zone.Zone Read on the certificate zone(s). Local dev and
# tests never call the DNS API (everything is mocked), so any placeholder
# works here; real value only needed for `wrangler dev` flows that hit it.
CF_DNS_API_TOKEN=test-only-token
