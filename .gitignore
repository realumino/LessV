# build & tooling state
node_modules/
frontend/node_modules/
frontend/dist/
# incremental tsc build state (tsc -b writes it next to tsconfig.json)
frontend/tsconfig.tsbuildinfo
# release artifacts (node tarballs)
dist/
# Rust build output (per-target, regenerated by cargo)
node/target/
.wrangler/
.pytest_cache/
__pycache__/
*.pyc

# ----- local-only, never commit -----
# real secrets; the *.example templates are committed on purpose
.dev.vars*
!.dev.vars.example
.env*
!.env.production.example
# real wrangler config (real domain, real D1 id): never commit.
# wrangler.example.jsonc is the committed template; the npm pre-hooks copy
# it when this file is missing.
wrangler.jsonc
# operator-local workspace: work-in-progress plans, acceptance run outputs,
# run reports. The public repo stays clean.
.plans/
# imported design bundle (static HTML mockups, generator manifests): reference
# material for the admin UI, not part of the deployable unit.
lessv-admin-design-cf/
